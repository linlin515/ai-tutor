# AI 学伴后端 - 环境变量配置
# 复制此文件为 .env 并填写实际值

# 数据库配置（开发用 SQLite，生产用 PostgreSQL）
DATABASE_URL=sqlite+aiosqlite:///./ai_tutor.db

# new-api 代理配置（兼容 OpenAI API 格式）
NEW_API_BASE_URL=http://localhost:3000/v1
NEW_API_KEY=sk-your-api-key-here

# OCR 配置
OCR_ENABLED=true

# JWT 密钥（生产环境请替换为随机字符串）
SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=72

# 默认 AI 模型
DEFAULT_AI_MODEL=gpt-4o-mini

# 日志级别
LOG_LEVEL=INFO

<?xml version="1.0" encoding="utf-8"?>
<!--
    Release 构建 — 仅允许 HTTPS 通信
    Debug 构建会在 app/src/debug/ 中覆盖此文件
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
